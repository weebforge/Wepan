{
  "name": "wepan",
  "version": "1.0.0",
  "description": "Wepan is our alternative to forgepanel's style.",
  "homepage": "https://github.com/weebforge/Wepan#readme",
  "bugs": {
    "url": "https://github.com/weebforge/Wepan/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weebforge/Wepan.git"
  },
  "license": "GPL-3.0-or-later",
  "author": "lezii006",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "prepublishOnly": "tsc",
    "build": "tsc -p tsconfig.json",
    "docgen": "npm run eslint && npm run build && npm run build:js && typedoc ./src --plugin typedoc-rhineai-theme --out ./docs && node dist/docgen",
    "eslint": "eslint ./src/**/* --fix && prettier src --write",
    "commit": "npm run docgen && node dist/@build/commit",
    "build:js": "esbuild panel/index.ts --bundle --outfile=panel/bundle.js --minify --sourcemap && uglifyjs panel/bundle.js -c -m --toplevel -o panel/bundle.js ",
    "watch:js": "esbuild panel/index.ts --bundle --outfile=panel/bundle.js --sourcemap --watch",
    "test": "npm run build && node dist/__scripts__/index"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@tryforge/forgescript": "github:tryforge/forgescript#dev",
    "@types/node": "^26.4.1",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typedoc": "^0.28.20",
    "typedoc-rhineai-theme": "^1.2.0",
    "typescript": "^6.0.3",
    "uglify-js": "^3.19.3"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.7",
    "tiny-typed-emitter": "^2.1.0"
  }
}
